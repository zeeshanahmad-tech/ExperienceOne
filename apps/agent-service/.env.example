# Gemini API key (given by the organizer) — never commit the real value
GEMINI_API_KEY=

# Resend
RESEND_API_KEY=
RESEND_SENDING_DOMAIN=

# Shared secret the email-worker must present to call this service
WORKER_SHARED_TOKEN=

# GCP project the Firestore client resolves against (ADC handles auth locally via `gcloud auth application-default login`)
GCP_PROJECT_ID=

# AHI Tender Search MCP, used only for the one handoff-proof query
AHI_MCP_URL=https://connect.ahiapp.ai/mcp

PORT=8080
